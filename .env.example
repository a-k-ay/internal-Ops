# Frontend build-time config.
# Leave VITE_API_URL blank for local dev — vite.config.js proxies /api to
# the backend on localhost:3001 so requests stay same-origin.
# For production, set this to the full API origin (no trailing /api), e.g.
#   VITE_API_URL=https://meeting-action-board-api.onrender.com
VITE_API_URL=
