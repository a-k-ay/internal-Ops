# Postgres connection string. Neon's pooled URL works. SSL is enabled in db.js.
DATABASE_URL=postgres://user:pass@host/db

# JWT signing secret — pick something long and random.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Where to listen locally. Vite's proxy expects 3001.
PORT=3001

# Google Gemini API key for AI meeting summaries / action-item extraction.
# Optional — the rest of the app works without it; AI endpoints return 503.
GEMINI_API_KEY=

# CORS: the exact origin the frontend will be served from in production.
# For local dev CORS already allows vite's http://localhost:5173 and :4173.
FRONTEND_URL=

NODE_ENV=development
